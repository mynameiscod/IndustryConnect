NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Production: exact Docker bridge gateway used by the host Nginx proxy. Empty trusts nobody.
TRUSTED_PROXY_IP=
# Set a distinct 32-byte hexadecimal key and an ignored local or deployment-mounted file path.
PROVIDER_CONFIG_KEY=
PROVIDER_CONFIG_PATH=
MONGODB_URI=mongodb://127.0.0.1:27017/expert_marketplace?replicaSet=rs0&directConnection=true
AUTH_PEPPER=replace-with-at-least-32-random-characters
BETA_ACCESS_MODE=invite
EXPERT_SIGNUP_ENABLED=false
PAYMENTS_MODE=disabled
LIVE_TRANSACTIONS_ENABLED=false
RELEASE_COMMIT=
RELEASE_EVIDENCE_PATH=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ROUTE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
SMTP_HOST=
EMAIL_PROVIDER=smtp
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# CLI only; never commit actual values
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
